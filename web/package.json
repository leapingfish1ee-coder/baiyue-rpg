{
  "name": "infinite-tilemap-mvp-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../rust --target web --out-dir ../web/public/wasm --out-name terrain_wasm --release",
    "dev": "npm run wasm:build && vite",
    "preview:test": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "build": "npm run wasm:build && tsc --noEmit && vite build",
    "test:smoke": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
